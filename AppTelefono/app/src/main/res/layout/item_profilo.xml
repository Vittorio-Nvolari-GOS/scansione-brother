<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#1a1d21"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/testo_soprannome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/testo_etichetta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9aa0a6"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/bottone_rinomina_profilo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️"
        android:textSize="14sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="10dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3a3f45" />

    <Button
        android:id="@+id/bottone_connetti_profilo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connetti"
        android:textSize="12sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="14dp"
        android:layout_marginStart="6dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1f5f8b" />

    <Button
        android:id="@+id/bottone_rimuovi_profilo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🗑"
        android:textSize="14sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="12dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8e2424" />

</LinearLayout>
